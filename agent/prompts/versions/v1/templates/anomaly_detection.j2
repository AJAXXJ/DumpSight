你的任务是根据当前系统特征和历史基线，判断系统是否存在异常，并输出结构化结论。

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
【当前系统特征】
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

系统状态:
  存活:       {{ log_feature.system_status.is_alive }}
  观测窗口:   1s={{ log_feature.window["1s"] | round(1) }}s  5s={{ log_feature.window["5s"] | round(1) }}s

流量:
  RX:         {{ log_feature.traffic.rx_pps | round(2) }} pps  /  {{ (log_feature.traffic.rx_pps * 8 / 1e6) | round(3) }} Mbps
  TX:         {{ log_feature.traffic.tx_pps | round(2) }} pps
  流量水平:   {{ log_feature.traffic.traffic_level }}
  长期趋势:   {{ log_feature.traffic.trend }}
  短期趋势:   {{ log_feature.traffic.short_trend }}
  稳定性:     {{ log_feature.traffic.stability }}
  平均包大小: {{ log_feature.traffic.packet_type }}

队列:
  均衡状态:   {{ log_feature.queue.status }}
  倾斜比:     {{ log_feature.queue.imbalance_ratio | round(4) }}

MBUF 内存池:
  空闲率:     {{ (log_feature.mempool.free_ratio * 100) | round(1) }}%
  状态:       {{ log_feature.mempool.status }}
  趋势:       {{ log_feature.mempool.trend }}

堆内存:
  空闲率:     {{ (log_feature.heap.free_ratio * 100) | round(1) }}%
  碎片率:     {{ (log_feature.heap.fragmentation * 100) | round(1) }}%
  状态:       {{ log_feature.heap.status }}

CPU:
  平均利用率: {{ (log_feature.cpu.avg_usage * 100) | round(2) }}%
  状态:       {{ log_feature.cpu.status }}
  趋势:       {{ log_feature.cpu.trend }}
  最热核心:   {{ log_feature.cpu.hot_lcore if log_feature.cpu.hot_lcore is not none else "N/A" }}

错误:
  RX错误:     {{ log_feature.errors.rx_errors }}
  TX错误:     {{ log_feature.errors.tx_errors }}
  MBUF不足:   {{ log_feature.errors.nombuf }}
  端口丢包:   {{ log_feature.errors.missed }}
  错误等级:   {{ log_feature.errors.severity }}

综合风险:
  风险评分:   {{ log_feature.risk_score }} / 100
  风险等级:   {{ log_feature.risk_level }}
  风险明细:   {{ log_feature.risk_breakdown }}
  当前洞察:   {{ log_feature.insight | join(" | ") }}
  风险标签:   {{ log_feature.risk | join(", ") if log_feature.risk else "无" }}

