【历史基线（参考）】
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

{% if reference_feature %}
  基线窗口:   {{ reference_feature.window_seconds | round(0) }}s  /  {{ reference_feature.sample_count }} 个样本
  RX pps:     {{ reference_feature.rx_pps | round(2) }}
  TX pps:     {{ reference_feature.tx_pps | round(2) }}
  RX错误:     {{ reference_feature.rx_errors }}
  MBUF不足:   {{ reference_feature.nombuf }}
  端口丢包:   {{ reference_feature.missed }}
  队列倾斜:   {{ reference_feature.queue_imbalance | round(4) }}
  内存池空闲: {{ (reference_feature.mempool_free * 100) | round(1) }}%
  堆内存空闲: {{ (reference_feature.heap_free * 100) | round(1) }}%
  CPU均值:    {{ (reference_feature.cpu_avg * 100) | round(2) }}%
  CPU峰值:    {{ (reference_feature.cpu_max * 100) | round(2) }}%
{% else %}
  暂无历史基线数据，请仅基于当前特征判断。
{% endif %}

